# Postgres — one database shared by every restaurant tenant
DATABASE_URL="postgresql://delightful:delightful@localhost:5544/delightful?schema=public"

PORT=4000
NODE_ENV=development

# Sign your own secret before deploying. Anything long and random.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# The domain every restaurant gets a subdomain of, with no DNS work per client:
# a restaurant with slug "delight-food" is reachable at delight-food.<this>.
# Point a wildcard CNAME (*.delightful.app) at the customer app deployment.
PLATFORM_DOMAIN=""

# Origins allowed to call the API that are NOT restaurant storefronts — chiefly
# the admin portal. Restaurant domains are resolved from the database, so they
# never need to be listed here.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Per-IP ceilings over a 10-minute window. Note that everyone on the restaurant's
# wifi shares one IP, so these are per-room, not per-customer. Raise for busy sites.
# Failed sign-ins per account per address (successful ones are never counted),
# and a looser backstop for one address failing against many different emails.
LOGIN_RATE_LIMIT=10
LOGIN_SPRAY_LIMIT=100

ORDER_RATE_LIMIT=60
TRACKING_RATE_LIMIT=600

# Seed credentials (dev only)
SEED_PLATFORM_EMAIL="platform@delightful.app"
SEED_PLATFORM_PASSWORD="platform123"
SEED_OWNER_EMAIL="owner@delightfood.in"
SEED_OWNER_PASSWORD="owner123"
