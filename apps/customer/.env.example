# Leave BLANK in production. One deployment serves every restaurant, and the API
# works out which one from the domain the visitor arrived on.
#
# Set it in development, where every restaurant would otherwise look like
# "localhost", and for a one-off build pinned to a single restaurant.
VITE_RESTAURANT_SLUG=delight-food

# Leave blank in development to use the Vite proxy.
# In production: https://api.yourdomain.com
VITE_API_URL=
