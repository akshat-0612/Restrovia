# Blank in development (uses the Vite proxy). In production point at the API:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# Base URL of the customer app, used to build table QR codes.
# Development only. In production each restaurant carries its own storefront URL
# (Settings -> Storefront), because one admin portal serves every restaurant and a
# single baked-in value would print the wrong address onto their table QR codes.
VITE_CUSTOMER_URL=http://localhost:5173
