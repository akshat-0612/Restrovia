{
  "name": "delightful",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Delightful — multi-tenant restaurant ordering platform (customer web app + owner admin portal)",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:customer dev:admin",
    "dev:server": "npm run dev -w server",
    "dev:customer": "npm run dev -w @delightful/customer",
    "dev:admin": "npm run dev -w @delightful/admin",
    "build": "npm run build -w @delightful/customer && npm run build -w @delightful/admin",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "npm run db:push -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "db:reset": "npm run db:reset -w server",
    "setup": "npm install && npm run db:up && sleep 4 && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
