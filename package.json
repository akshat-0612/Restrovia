{
  "name": "restrovia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Restrovia \u2014 multi-tenant restaurant ordering platform (customer web app + owner admin portal)",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:customer dev:admin",
    "dev:server": "npm run dev -w server",
    "dev:customer": "npm run dev -w @restrovia/customer",
    "dev:admin": "npm run dev -w @restrovia/admin",
    "build": "npm run build -w @restrovia/customer && npm run build -w @restrovia/admin",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "npm run db:push -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "db:reset": "npm run db:reset -w server",
    "setup": "npm install && npm run db:up && sleep 4 && npm run db:migrate && npm run db:seed",
    "build:customer": "npm run build -w @restrovia/customer",
    "build:admin": "npm run build -w @restrovia/admin",
    "start:server": "npm run start -w server",
    "prisma:generate": "npm run generate -w server",
    "prisma:deploy": "npm run db:deploy -w server",
    "build:server": "npm run prisma:generate && npm run prisma:deploy"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
